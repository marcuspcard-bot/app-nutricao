{
  "expo": {
    "name": "App Nutricao",
    "slug": "app",
    "scheme": "appnutricao",
    "version": "1.0.0",
    "icon": "./assets/icon-v2.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "backgroundColor": "#00000000"
      },
      "package": "com.anonymous.appnutricao",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso as fotos para publicar imagens das refeicoes na comunidade.",
          "cameraPermission": "Permita o acesso a camera para fotografar suas refeicoes e publicar na comunidade."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a0279c8f-f46c-44d5-bd1a-d54a5ec1a67c"
      }
    },
    "owner": "marcusp7s-organization"
  }
}
